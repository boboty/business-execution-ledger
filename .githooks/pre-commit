#!/bin/sh
# Blocks a commit that stages real business data (see
# docs/PRIVATE-DATA-POLICY.md) or edits an already-committed migration
# file (see docs/PERSISTENCE-MIGRATION-POLICY.md, M1). Both checks run;
# neither replaces the other.
# Install once: git config core.hooksPath .githooks

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    PYTHON="python"
fi

"$PYTHON" "$REPO_ROOT/tools/privacy_scan.py" --staged
"$PYTHON" "$REPO_ROOT/tools/check_migration_immutability.py" --staged
