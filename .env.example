# Local development environment template. Copy to .env (gitignored,
# never committed) and fill in real values, or export the same variable
# directly in your shell — either way, plain environment variables are
# all BEL reads. No dotenv dependency is required; if your shell doesn't
# auto-load .env, source it yourself (e.g. `set -a; source .env; set +a`)
# or use direnv / your editor's own env-file support.
#
# BEL_DATABASE_URL is BEL's ONE runtime configuration contract — Alembic,
# the CLI, Web, and the startup schema gate all consume this same URL.
# See docs/PERSISTENCE-MIGRATION-POLICY.md.
#
# Canonical form: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# A password containing reserved URL characters (@, %, /, etc.) must be
# percent-encoded (@ -> %40, % -> %25, / -> %2F, ...).
BEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Only needed for local/private cutover-backfill acceptance runs — see
# docs/PRIVATE-DATA-POLICY.md. Never a path inside this repository.
# BEL_PRIVATE_DATA_ROOT=/absolute/path/outside/this/repo
