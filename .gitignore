# Real business data (contracts, invoices, bank statements, counterparties, etc.)
# Never commit this. Anonymized/synthetic subsets may later be promoted into fixtures/.
data/private/

# OS / editor noise
.DS_Store
*.swp

# Python toolchain
node_modules/
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Runtime SQLite databases — schema lives in migrations/, not the binary file
*.db
*.db-journal
*.db-shm
*.db-wal

# Local database runtime credentials (BEL_DATABASE_URL, etc.) — never
# committed. See .env.example for the placeholder template and
# docs/PERSISTENCE-MIGRATION-POLICY.md for the runtime contract.
.env
.env.local
.env.*.local
